# Copy to .env and fill in. Paper keys only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# TypeSafe AI (Jev). Optional; leave blank until waitlist access arrives.
TYPESAFE_API_KEY=

# Phone alerts via ntfy (https://ntfy.sh). Optional. Pick a long random topic name, subscribe to it in the
# ntfy phone app, and put it here; anyone who knows the name can read the alerts. Test: scripts/notify_test.py
# NTFY_TOPIC=

# Massive (formerly Polygon.io). Optional: only the one-time backfill of delisted stocks uses it
# (scripts/repair_daily_panel.py). The bot and the studies never call it.
# MASSIVE_API_KEY=

# Contact line for requests to the SEC's EDGAR (earnings dates, scripts/download_earnings_dates.py).
# The SEC asks automated readers to say who they are. Private: keep it here only.
# SEC_CONTACT=
